{
  "name": "screeps-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A Screeps bot, and the supply-chain-hardened delivery pipeline around it.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "coverage:check": "node scripts/coverage-ratchet.mjs",
    "coverage:baseline": "jest --coverage --silent && node scripts/coverage-ratchet.mjs --update"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.4.0",
    "@types/screeps": "3.4.0",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "jest": "30.4.2",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
