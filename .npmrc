# Supply-chain baseline. Do not disable.
#
# ignore-scripts blocks lifecycle scripts (preinstall/install/postinstall) from
# every package in the tree. This is the single highest-value npm setting for
# supply-chain defence: the overwhelming majority of malicious-package incidents
# execute via an install script.
#
# If a dependency genuinely requires a lifecycle script, that gets surfaced and
# decided deliberately -- see docs/DECISIONS.md. It does not get fixed by
# turning this off.
ignore-scripts=true

# Reproducibility: never silently mutate the lockfile during install.
save-exact=true
